FROM ubuntu:24.04

ARG APP_USER=michael

ENV DEBIAN_FRONTEND=noninteractive

# Create user with writable home
RUN usermod -l ${APP_USER} ubuntu && \
    groupmod -n ${APP_USER} ubuntu && \
    usermod -d /home/${APP_USER} -m ${APP_USER}

# Install dependencies
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    git \
    bash \
    python3 \
    python3-pip \
    python3-venv \
    virtualenv \
    build-essential \
    sudo \
    bash-completion \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 24.x
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y nodejs \
    && node --version \
    && npm --version

# Optional: install common global tools
RUN npm install -g \
    npm \
    yarn \
    pnpm

# Install OpenCode as root, then copy to system-wide location
RUN curl -fsSL https://opencode.ai/install | bash && \
    cp /root/.opencode/bin/opencode /usr/local/bin/opencode && \
    chmod +x /usr/local/bin/opencode

USER ${APP_USER}
WORKDIR /home/${APP_USER}

CMD OPENCODE_ENABLE_EXA=1 opencode
